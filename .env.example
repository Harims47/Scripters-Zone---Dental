# ==============================================================================
# DentalCore Frontend Environment Configuration Template
# ==============================================================================

# API Base URL for frontend requests:
# - LOCAL DEVELOPMENT:
#   Leave empty (or comment out). Vite dev server automatically proxies all
#   '/api' and '/uploads' requests to the backend at http://localhost:3001.
# - PRODUCTION SERVER (https://rafidentalclinic.com):
#   Leave empty. The unified server serves both frontend and /api on the same domain.
# - DEDICATED API SERVER:
#   If your backend is hosted on a separate domain (e.g. https://api.rafidentalclinic.com),
#   set that full URL here.
VITE_API_BASE_URL=
