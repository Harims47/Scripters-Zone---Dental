# ==============================================================================
# DentalCore Backend Environment Configuration Template
# Copy this file to .env (or server/.env) to configure the backend.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. LOCAL DEVELOPMENT PROFILE (Default for local workstation)
# ------------------------------------------------------------------------------
NODE_ENV=development
PORT=3001

# Local MySQL Database Connection
DATABASE_URL="mysql://dental:dentalpassword@127.0.0.1:3306/dentalcore_test"
SHADOW_DATABASE_URL="mysql://dental:dentalpassword@127.0.0.1:3306/dentalcore_shadow"

# JWT Secret (minimum 32 characters in production)
JWT_SECRET="dev_secret_key_change_in_production"

# Allowed CORS Origins (comma-separated, no trailing slashes)
FRONTEND_ORIGIN="http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173"

# Communication & Notification Settings
NOTIFICATION_ENV="development"
# AISENSY_API_KEY=""

# ------------------------------------------------------------------------------
# 2. SERVER / PRODUCTION PROFILE (GoDaddy / cPanel / Render)
# When deploying to the server, uncomment and configure this section:
# ------------------------------------------------------------------------------
# NODE_ENV=production
# PORT=3001
# FRONTEND_ORIGIN="https://rafidentalclinic.com,https://www.rafidentalclinic.com"
# JWT_SECRET="your_ultra_secure_random_jwt_secret_at_least_32_characters"
# NOTIFICATION_ENV="production"
# AISENSY_API_KEY="your_aisensy_production_key"

# Database Configuration (Choose Option A or Option B):
# Option A: GoDaddy native environment variables
# DB_HOST=localhost
# DB_PORT=3306
# DB_NAME=your_godaddy_db_name
# DB_USER=your_godaddy_db_user
# DB_PASSWORD=your_godaddy_db_password

# Option B: Standard MySQL URL
# DATABASE_URL="mysql://username:password@localhost:3306/dentalcore_prod"

# Optional Initialization Hooks (Set to 'true' only once on fresh deployment, then remove)
# MIGRATION_EXECUTE_ONCE=false
# INIT_HEAD_DOCTOR_ONCE=false
