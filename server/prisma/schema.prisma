generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String   @id @default(uuid())
  username     String   @unique
  passwordHash String
  role         String
  staffId      String?  @unique
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  staff        Staff?   @relation(fields: [staffId], references: [id])
}

model Staff {
  id        String   @id @default(uuid())
  name      String
  phone     String
  role      String
  status    String   @default("Active")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User?
}

model Patient {
  id        String    @id @default(uuid())
  name      String
  phone     String    @unique
  age       Int
  gender    String
  status    String    @default("Active")
  photoUrl  String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  payments      Payment[]
  visits        Visit[]
  treatmentPlan TreatmentPlan?
}

model Appointment {
  id         String   @id @default(uuid())
  patientId  String
  providerId String?
  date       String
  time       String
  type       String
  status     String   @default("Scheduled")
  notes      String?
  photoUrl   String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  visit      Visit?
}

model Visit {
  id              String        @id @default(uuid())
  patientId       String
  doctorId        String?
  appointmentId   String?       @unique
  status          String
  amountDue       Float         @default(0)
  consultationFee Float?
  treatmentFee    Float?
  medicineCost    Float?
  reasonForVisit  String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  consultation    Consultation?
  dispensing      Dispensing?
  payment         Payment?
  prescription    Prescription?
  queueEntry      QueueEntry?
  appointment             Appointment?        @relation(fields: [appointmentId], references: [id])
  patient                 Patient             @relation(fields: [patientId], references: [id])
  completedTreatmentItems TreatmentPlanItem[]
}

model QueueEntry {
  id               String   @id @default(uuid())
  visitId          String   @unique
  patientId        String
  assignedDoctorId String?
  position         Int
  status           String
  priority         Boolean  @default(false)
  arrivalTime      String
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  visit            Visit    @relation(fields: [visitId], references: [id])
}

model Consultation {
  id              String   @id @default(uuid())
  visitId         String   @unique
  doctorId        String
  reasonForVisit  String
  clinicalNotes   String
  consultationFee Float
  treatmentFee    Float?
  status          String   @default("In Progress")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  visit           Visit    @relation(fields: [visitId], references: [id])
}

model Medicine {
  id                String             @id @default(uuid())
  name              String
  genericName       String?
  categoryId        String
  form              String
  unit              String
  stockWarningLevel Int
  currentStock      Int                @default(0)
  unitPrice         Float
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  dispensingItems   DispensingItem[]
  prescriptionItems PrescriptionItem[]
}

model Prescription {
  id         String             @id @default(uuid())
  visitId    String             @unique
  doctorId   String
  status     String             @default("Draft")
  notes      String
  createdAt  DateTime           @default(now())
  updatedAt  DateTime           @updatedAt
  dispensing Dispensing?
  visit      Visit              @relation(fields: [visitId], references: [id])
  items      PrescriptionItem[]
}

model PrescriptionItem {
  id             String       @id @default(uuid())
  prescriptionId String
  medicineId     String
  quantity       Int
  dosage         String?
  frequency      String?
  duration       String?
  instructions   String
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  medicine       Medicine     @relation(fields: [medicineId], references: [id])
  prescription   Prescription @relation(fields: [prescriptionId], references: [id])
}

model Dispensing {
  id             String           @id @default(uuid())
  visitId        String           @unique
  prescriptionId String           @unique
  status         String           @default("Pending")
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  prescription   Prescription     @relation(fields: [prescriptionId], references: [id])
  visit          Visit            @relation(fields: [visitId], references: [id])
  items          DispensingItem[]
}

model DispensingItem {
  id                 String     @id @default(uuid())
  dispensingId       String
  medicineId         String
  prescribedQuantity Int
  dispensedQuantity  Int        @default(0)
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt
  dispensing         Dispensing @relation(fields: [dispensingId], references: [id])
  medicine           Medicine   @relation(fields: [medicineId], references: [id])
}

model Payment {
  id        String   @id @default(uuid())
  visitId   String   @unique
  patientId String
  amount    Float
  method    String
  status    String   @default("Pending")
  date      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  patient   Patient  @relation(fields: [patientId], references: [id])
  visit     Visit    @relation(fields: [visitId], references: [id])
}

model TreatmentCatalog {
  id          String              @id @default(uuid())
  category    String
  name        String
  variant     String?
  isActive    Boolean             @default(true)
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  planItems   TreatmentPlanItem[]
}

model TreatmentPlan {
  id        String              @id @default(uuid())
  patientId String              @unique
  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt
  patient   Patient             @relation(fields: [patientId], references: [id])
  items     TreatmentPlanItem[]
}

model TreatmentPlanItem {
  id                 String           @id @default(uuid())
  treatmentPlanId    String
  treatmentCatalogId String
  status             String           @default("Planned") // "Planned" | "Completed"
  notes              String?
  completedVisitId   String?
  completedAt        DateTime?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  treatmentPlan      TreatmentPlan    @relation(fields: [treatmentPlanId], references: [id])
  catalogItem        TreatmentCatalog @relation(fields: [treatmentCatalogId], references: [id])
  completedVisit     Visit?           @relation(fields: [completedVisitId], references: [id])
}
