generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String   @id @default(uuid())
  username     String   @unique
  passwordHash String
  role         String
  staffId      String?  @unique
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  staff        Staff?   @relation(fields: [staffId], references: [id])
}

model Staff {
  id        String   @id @default(uuid())
  name      String
  phone     String
  role       String
  status     String   @default("Active")
  attendance String   @default("Present")
  roomNumber String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User?
}

model Patient {
  id        String    @id @default(uuid())
  name      String
  phone     String    @unique
  age       Int
  gender    String
  status    String    @default("Active")
  photoUrl  String?
  address   String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  payments      Payment[]
  visits        Visit[]
  treatmentPlan TreatmentPlan?
}

model Appointment {
  id         String   @id @default(uuid())
  patientId  String
  providerId String?
  date       String
  time       String
  type       String
  status     String   @default("Scheduled")
  notes      String?
  photoUrl   String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  visit      Visit?
}

model Visit {
  id              String        @id @default(uuid())
  patientId       String
  doctorId        String?
  appointmentId   String?       @unique
  status          String
  amountDue       Float         @default(0)
  consultationFee Float?
  treatmentFee    Float?
  medicineCost    Float?
  reasonForVisit  String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  consultation    Consultation?
  dispensing      Dispensing?
  payments        Payment[]
  prescription    Prescription?
  queueEntry      QueueEntry?
  appointment             Appointment?        @relation(fields: [appointmentId], references: [id])
  patient                 Patient             @relation(fields: [patientId], references: [id])
  completedTreatmentItems TreatmentPlanItem[]
}

model QueueEntry {
  id               String   @id @default(uuid())
  visitId          String   @unique
  patientId        String
  assignedDoctorId String?
  position         Int
  status           String
  priority         Boolean  @default(false)
  arrivalTime      String
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  visit            Visit    @relation(fields: [visitId], references: [id])
}

model Consultation {
  id              String   @id @default(uuid())
  visitId         String   @unique
  doctorId        String
  reasonForVisit  String
  clinicalNotes   String
  consultationFee Float
  treatmentFee    Float?
  status          String   @default("In Progress")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  visit           Visit    @relation(fields: [visitId], references: [id])
}

model MedicineCategory {
  id          String                     @id @default(uuid())
  name        String                     @unique
  description String?
  status      String                     @default("Active")
  createdAt   DateTime                   @default(now())
  updatedAt   DateTime                   @updatedAt
  medicines   Medicine[]
  suppliers   SupplierMedicineCategory[]
}

model Medicine {
  id                 String              @id @default(uuid())
  name               String
  genericName        String?
  categoryId         String
  category           MedicineCategory    @relation(fields: [categoryId], references: [id])
  form               String
  unit               String
  stockWarningLevel  Int
  currentStock       Int                 @default(0)
  unitPrice          Float
  status             String              @default("Active")
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  dispensingItems    DispensingItem[]
  prescriptionItems  PrescriptionItem[]
  purchaseOrderItems PurchaseOrderItem[]
  stockMovements     StockMovement[]
}

model Prescription {
  id         String             @id @default(uuid())
  visitId    String             @unique
  doctorId   String
  status     String             @default("Draft")
  notes      String
  createdAt  DateTime           @default(now())
  updatedAt  DateTime           @updatedAt
  dispensing Dispensing?
  visit      Visit              @relation(fields: [visitId], references: [id])
  items      PrescriptionItem[]
}

model PrescriptionItem {
  id             String       @id @default(uuid())
  prescriptionId String
  medicineId     String
  quantity       Int
  dosage         String?
  frequency      String?
  duration       String?
  instructions   String
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  medicine       Medicine     @relation(fields: [medicineId], references: [id])
  prescription   Prescription @relation(fields: [prescriptionId], references: [id])
}

model Dispensing {
  id             String           @id @default(uuid())
  visitId        String           @unique
  prescriptionId String           @unique
  status         String           @default("Pending")
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  prescription   Prescription     @relation(fields: [prescriptionId], references: [id])
  visit          Visit            @relation(fields: [visitId], references: [id])
  items          DispensingItem[]
}

model DispensingItem {
  id                 String     @id @default(uuid())
  dispensingId       String
  medicineId         String
  prescribedQuantity Int
  dispensedQuantity  Int        @default(0)
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt
  dispensing         Dispensing @relation(fields: [dispensingId], references: [id])
  medicine           Medicine   @relation(fields: [medicineId], references: [id])
}

model Payment {
  id        String   @id @default(uuid())
  visitId   String
  patientId String
  amount    Float
  method    String
  status    String   @default("Pending")
  notes     String?
  date      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  patient   Patient  @relation(fields: [patientId], references: [id])
  visit     Visit    @relation(fields: [visitId], references: [id])
}

model TreatmentCatalog {
  id          String              @id @default(uuid())
  category    String
  name        String
  variant     String?
  isActive    Boolean             @default(true)
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  planItems   TreatmentPlanItem[]
}

model TreatmentPlan {
  id        String              @id @default(uuid())
  patientId String              @unique
  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt
  patient   Patient             @relation(fields: [patientId], references: [id])
  items     TreatmentPlanItem[]
}

model TreatmentPlanItem {
  id                 String           @id @default(uuid())
  treatmentPlanId    String
  treatmentCatalogId String
  status             String           @default("Planned") // "Planned" | "Completed"
  notes              String?
  completedVisitId   String?
  completedAt        DateTime?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  treatmentPlan      TreatmentPlan    @relation(fields: [treatmentPlanId], references: [id])
  catalogItem        TreatmentCatalog @relation(fields: [treatmentCatalogId], references: [id])
  completedVisit     Visit?           @relation(fields: [completedVisitId], references: [id])
}

model Supplier {
  id             String                     @id @default(uuid())
  name           String
  contactPerson  String?
  phone          String?
  email          String?
  address        String?
  status         String                     @default("Active") // "Active" | "Inactive"
  createdAt      DateTime                   @default(now())
  updatedAt      DateTime                   @updatedAt
  purchaseOrders PurchaseOrder[]
  bills          SupplierBill[]
  categories     SupplierMedicineCategory[]
}

model SupplierMedicineCategory {
  id                 String           @id @default(uuid())
  supplierId         String
  medicineCategoryId String
  createdAt          DateTime         @default(now())
  supplier           Supplier         @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  medicineCategory   MedicineCategory @relation(fields: [medicineCategoryId], references: [id], onDelete: Cascade)

  @@unique([supplierId, medicineCategoryId])
}

model PurchaseOrder {
  id          String              @id @default(uuid())
  orderNumber String              @unique
  supplierId  String
  orderDate   DateTime            @default(now())
  status      String              @default("Draft") // "Draft" | "Ordered" | "Partially Received" | "Received" | "Cancelled"
  notes       String?
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  supplier    Supplier            @relation(fields: [supplierId], references: [id])
  items       PurchaseOrderItem[]
  bills       SupplierBill[]
}

model PurchaseOrderItem {
  id               String        @id @default(uuid())
  purchaseOrderId  String
  medicineId       String
  orderedQuantity  Int
  receivedQuantity Int           @default(0)
  unitCost         Float         @default(0)
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  purchaseOrder    PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  medicine         Medicine      @relation(fields: [medicineId], references: [id])
}

model SupplierBill {
  id              String            @id @default(uuid())
  supplierId      String
  purchaseOrderId String?
  invoiceNumber   String
  invoiceDate     DateTime          @default(now())
  amount          Float
  billImageUrl    String?           @db.Text
  notes           String?
  status          String            @default("Unpaid") // "Unpaid" | "Partial" | "Paid" | "Cancelled"
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  supplier        Supplier          @relation(fields: [supplierId], references: [id])
  purchaseOrder   PurchaseOrder?    @relation(fields: [purchaseOrderId], references: [id])
  payments        SupplierPayment[]
}

model SupplierPayment {
  id             String       @id @default(uuid())
  supplierBillId String
  amount         Float
  method         String       // "Cash" | "Bank Transfer" | "UPI"
  notes          String?
  date           DateTime     @default(now())
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  bill           SupplierBill @relation(fields: [supplierBillId], references: [id], onDelete: Restrict)
}

model StockMovement {
  id            String   @id @default(uuid())
  medicineId    String
  movementType  String   // "PURCHASE_RECEIPT" | "DISPENSING" | "ADJUSTMENT"
  quantity      Int      // Positive for additions, negative for deductions
  balanceAfter  Int      // Running balance for quick auditing
  referenceType String?  // "PURCHASE_ORDER" | "VISIT" | "MANUAL"
  referenceId   String?  // PO ID or Visit ID
  reason        String?  // Reason for adjustment / receiving note
  performedBy   String?  // User/Staff identifier / username
  createdAt     DateTime @default(now())
  medicine      Medicine @relation(fields: [medicineId], references: [id])
}

